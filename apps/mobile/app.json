{
  "expo": {
    "name": "LM-Vision Inspector",
    "slug": "lm-vision-inspector",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "scheme": "lmvision",
    "ios": {
      "supportsTablet": false
    },
    "android": {
      "package": "com.lmvision.inspector",
      "versionCode": 1,
      "adaptiveIcon": {
        "backgroundColor": "#0f172a"
      },
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.INTERNET",
        "android.permission.ACCESS_NETWORK_STATE",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "bundler": "metro"
    },
    "plugins": [
      [
        "expo-camera",
        {
          "cameraPermission": "Allow LM-Vision Inspector to access camera for packaging inspections."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow LM-Vision Inspector to access photos for declaration analysis."
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "3a808489-8683-4060-9554-bf22ada0e154"
      }
    },
    "owner": "lm-vision"
  }
}
