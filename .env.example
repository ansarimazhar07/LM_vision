# NOTE: DO NOT commit real secrets to version control.
# Copy this file to .env or .env.local for local development.

# --- App Environment ---
NODE_ENV=development
APP_PORT=3000

# --- Public Client Configuration (Safe to expose to browser / mobile) ---
NEXT_PUBLIC_APP_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:3000/api/v1
NEXT_PUBLIC_SUPABASE_URL=https://placeholder-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.placeholder-anon-key

# --- Server-Only Configuration (NEVER expose to client applications) ---
# Supabase Admin / Service Role
SUPABASE_SERVICE_ROLE_KEY=placeholder-service-role-key-never-expose-to-client
SUPABASE_JWT_SECRET=placeholder-jwt-secret-min-32-chars-long-example

# AI Provider API Keys & Model Config (Used ONLY by server-side AI engine)
AI_DEFAULT_PROVIDER=MOCK
GEMINI_API_KEY=placeholder-gemini-api-key-for-server-only
GEMINI_MODEL=gemini-1.5-pro
OPENAI_API_KEY=placeholder-openai-api-key-for-server-only
OPENAI_MODEL=gpt-4o
MOCK_AI_MODEL=mock-vision-engine-v1

# Server Rate Limiting & Security
RATE_LIMIT_MAX_REQUESTS=100
RATE_LIMIT_WINDOW_MS=60000
