{
  "name": "@lm-vision/supabase-client",
  "version": "0.2.0",
  "private": true,
  "description": "LM-Vision Supabase Client — typed database clients, auth utilities, and domain adapters",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./types": {
      "types": "./dist/types/database.d.ts",
      "import": "./dist/types/database.js",
      "default": "./dist/types/database.js"
    },
    "./auth": {
      "types": "./dist/auth/index.d.ts",
      "import": "./dist/auth/index.js",
      "default": "./dist/auth/index.js"
    },
    "./browser": {
      "types": "./dist/clients/browser.d.ts",
      "import": "./dist/clients/browser.js",
      "default": "./dist/clients/browser.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@lm-vision/config": "*",
    "@lm-vision/shared-types": "*",
    "@supabase/supabase-js": "^2.45.0"
  },
  "devDependencies": {
    "typescript": "^5.5.4"
  }
}
