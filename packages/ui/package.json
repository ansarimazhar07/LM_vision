{
  "name": "@lm-vision/ui",
  "version": "0.1.0",
  "private": true,
  "description": "LM-Vision Shared UI Design Tokens, Themes, and Component Contracts",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./*": {
      "types": "./dist/*.d.ts",
      "import": "./dist/*.js",
      "default": "./dist/*.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@lm-vision/shared-types": "*"
  },
  "devDependencies": {
    "typescript": "^5.5.4"
  }
}
