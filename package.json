{
  "name": "lm-vision-monorepo",
  "version": "0.1.0",
  "private": true,
  "description": "LM-Vision - SIH 2026 Problem Statement 26034 Monorepo",
  "workspaces": [
    "packages/*",
    "apps/*",
    "services/*"
  ],
  "scripts": {
    "typecheck": "npm run typecheck --workspaces --if-present",
    "build": "npm run build --workspaces --if-present",
    "build:backend": "npm run build --workspace=@lm-vision/config --if-present && npm run build --workspace=@lm-vision/shared-types --if-present && npm run build --workspace=@lm-vision/rules --if-present && npm run build --workspace=@lm-vision/validation --if-present && npm run build --workspace=@lm-vision/ai-engine",
    "test": "vitest run",
    "test:watch": "vitest",
    "start:mobile": "npm run start --workspace=@lm-vision/mobile",
    "start:mobile:web": "npm run web --workspace=@lm-vision/mobile",
    "start:mobile:android": "npm run android --workspace=@lm-vision/mobile",
    "start:ai": "npm run dev --workspace=@lm-vision/ai-engine",
    "start:backend": "node services/ai-engine/dist/run-server.js",
    "lint": "echo \"Linting placeholder for Phase 1\""
  },
  "devDependencies": {
    "@types/node": "^26.4.1",
    "typescript": "^5.5.4",
    "vitest": "^2.1.1",
    "zod": "^3.23.8"
  },
  "overrides": {
    "react": "19.2.3",
    "react-native-safe-area-context": "5.7.0",
    "react-native-screens": "4.26.2"
  },
  "dependencies": {
    "react": "19.2.3",
    "react-native-safe-area-context": "5.7.0",
    "react-native-screens": "4.26.2"
  }
}
